{
  "name": "foreteller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts serve",
    "doctor": "tsx src/main.ts doctor",
    "report": "tsx src/main.ts report",
    "replay": "tsx src/main.ts replay",
    "start": "node dist/src/main.js serve",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.12.0",
    "@polymarket/client": "^0.10.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.2",
    "grammy": "^1.46.0",
    "viem": "^2.56.8",
    "ws": "^8.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.3"
}
