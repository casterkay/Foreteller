POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=2

# Runtime
DATABASE_PATH=./data/foreteller.sqlite
SESSION_DATA_DIR=./data/sessions
LIVE_TRADING=false
LOG_LEVEL=info
